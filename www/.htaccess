<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Un fichier statique absent doit rester une 404. Le transformer en
  # index.html provoque une erreur MIME et masque la vraie cause au navigateur.
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|json|map|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

FileETag None

<FilesMatch "^index\.html$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </IfModule>
</FilesMatch>

<FilesMatch "\.json$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>

<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|avif|ico|woff2?|ttf|otf)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
