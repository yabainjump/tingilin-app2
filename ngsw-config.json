{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/svg/**",
          "/*.(png|jpg|jpeg|webp|svg|gif|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "public-api",
      "urls": [
        "https://backend.tinguilin.yaba-in.com/api/v1/raffles/home-feed**",
        "https://backend.tinguilin.yaba-in.com/api/v1/raffles/public**",
        "https://backend.tinguilin.yaba-in.com/api/v1/raffles/live**",
        "https://backend.tinguilin.yaba-in.com/api/v1/raffles/*",
        "https://backend.tinguilin.yaba-in.com/share/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "5s"
      }
    },
    {
      "name": "media",
      "urls": [
        "https://backend.tinguilin.yaba-in.com/uploads/**",
        "https://tinguilin.yaba-in.com/assets/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "5s"
      }
    }
  ]
}
